# Keep the image small and, more importantly, keep local secrets and local
# state out of it. Docker does not read .gitignore, so anything that must not
# be baked into a layer has to be listed here.

# Secrets and local config. Render supplies these as environment variables.
backend/.env
backend/.env.example

# Virtualenvs and local databases
.venv/
backend/.venv/
**/__pycache__/
**/*.py[cod]
*.db
*.sqlite3

# Locally uploaded photos. In production a mounted disk provides this directory.
backend/uploads/

# Rebuilt inside the image, so never copy the host's copies.
frontend/node_modules/
frontend/dist/

# Repo furniture with no place in a runtime image
.git/
.github/
.idea/
.vscode/
.DS_Store
docker-compose.yml
README.md
CLAUDE.md
LICENSE
main.py
